{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kaitag Lexeme",
  "type": "object",
  "required": [
    "headword",
    "definitions"
  ],
  "properties": {
    "headword": {
      "description": "Main word form",
      "type": "string"
    },
    "ipa": {
      "description": "IPA transcription of the headword",
      "type": "string"
    },
    "tags": {
      "description": "Entry-level grammar and etymology tags (see meta/tags.yaml)",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forms": {
      "description": "Inflectional paradigm",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "gloss"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "description": "Inflected form text",
            "type": "string"
          },
          "gloss": {
            "description": "Leipzig gloss code, comma-separated for syncretism (e.g. obl, loc)",
            "type": "string"
          }
        }
      }
    },
    "definitions": {
      "description": "Senses of the word, each with translation, examples, and optional metadata",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "translation"
        ],
        "properties": {
          "translation": {
            "description": "Translation of this sense",
            "$ref": "#/definitions/bilingualText"
          },
          "tags": {
            "description": "Definition-level semantic and register tags (see meta/tags.yaml)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "aliases": {
            "description": "Synonyms and hypernyms for search discoverability",
            "type": "object",
            "properties": {
              "en": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ru": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "note": {
            "description": "Notes specific to this definition",
            "$ref": "#/definitions/bilingualText"
          },
          "examples": {
            "description": "Usage examples",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "translation"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "description": "Example sentence in Kaitag",
                  "type": "string"
                },
                "translation": {
                  "description": "Translation of this example",
                  "$ref": "#/definitions/bilingualText"
                }
              }
            }
          }
        }
      }
    },
    "note": {
      "description": "Word-level notes",
      "$ref": "#/definitions/bilingualText"
    },
    "etymology": {
      "description": "Word origin for loanwords and non-obvious formations",
      "$ref": "#/definitions/bilingualText"
    },
    "derived_from": {
      "description": "Source headwords this entry is derived from",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variants": {
      "description": "Dialectal or alternative forms",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "see_also": {
      "description": "Related headwords to cross-reference",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "bilingualText": {
      "type": "object",
      "required": [
        "en",
        "ru"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string"
        },
        "ru": {
          "type": "string"
        }
      }
    }
  }
}
