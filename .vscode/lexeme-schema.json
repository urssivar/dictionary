{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kaitag Dictionary Entry",
  "type": "object",
  "required": [
    "id",
    "headword",
    "definitions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique entry identifier."
    },
    "headword": {
      "type": "string",
      "description": "Main word form."
    },
    "ipa": {
      "type": "string",
      "description": "IPA pronunciation."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Entry-level grammar and etymology tags (see data/tags.yaml)."
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "description": "Word form."
          },
          "gloss": {
            "type": "string",
            "description": "Leipzig glossing abbreviation (e.g., ipfv, pret, pfv, abs, pl). Comma-separated for syncretic forms serving multiple functions (e.g., `obl, loc`)."
          }
        }
      }
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "translation"
        ],
        "properties": {
          "translation": {
            "$ref": "#/definitions/bilingualText",
            "description": "Translation in English/Russian."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Definition-level semantic and register tags (see data/tags.yaml)."
          },
          "aliases": {
            "type": "object",
            "description": "Synonyms and hypernyms for search discoverability (not displayed in UI).",
            "properties": {
              "en": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ru": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "note": {
            "$ref": "#/definitions/bilingualText",
            "description": "Notes specific to this definition."
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "translation"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "description": "Example sentence in Kaitag."
                },
                "translation": {
                  "$ref": "#/definitions/bilingualText",
                  "description": "Translation of example."
                }
              }
            }
          }
        }
      }
    },
    "note": {
      "$ref": "#/definitions/bilingualText",
      "description": "Word-level notes."
    },
    "etymology": {
      "$ref": "#/definitions/bilingualText",
      "description": "Word origin. Include for loanwords and non-obvious formations."
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dialectal or alternative forms. Slash-separate paradigm forms within one string; use ~ for forms matching the headword."
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Source headwords this entry is derived from."
    },
    "see_also": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related headwords to cross-reference."
    }
  },
  "definitions": {
    "bilingualText": {
      "type": "object",
      "required": ["en", "ru"],
      "properties": {
        "en": {
          "type": "string",
          "description": "English text."
        },
        "ru": {
          "type": "string",
          "description": "Russian text."
        }
      }
    }
  }
}
